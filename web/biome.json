{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "vite.config.ts", "package.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noArrayMethodsOnArguments": "error",
        "noConstantComparisons": "error",
        "noErasingOperation": "error",
        "noNegatedArrayPredicate": "error",
        "noNumberArgumentOutOfRange": "error",
        "noSharedBranchCode": "error",
        "noSubtractionComparison": "error",
        "noSvelteIgnoredUnsubscribe": "error",
        "noUninvokedArrayCallback": "error",
        "useNextScriptForGoogleAnalytics": "error",
        "usePackageJsonCpu": "error",
        "usePackageJsonEngines": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
